--- /dev/null
+++ b/src/frame_io.c
@@ -0,0 +1,18 @@
+#include "frame_client.h"
+#include "frame_io.h"
+int frame_transfer_exact(transport *connection, int writing, unsigned char *data,
+                          size_t wanted, uint64_t began, unsigned timeout_ms) {
+    size_t offset = 0;
+    while (offset < wanted) {
+        uint64_t elapsed = transport_now_ms() - began;
+        long n;
+        if (elapsed >= timeout_ms) return FRAME_TIMEOUT;
+        n = writing ? transport_write(connection, data + offset, wanted - offset, timeout_ms - (unsigned)elapsed)
+                    : transport_read(connection, data + offset, wanted - offset, timeout_ms - (unsigned)elapsed);
+        if (n == -2) continue;
+        if (n <= 0 || (size_t)n > wanted - offset) return FRAME_IO;
+        offset += (size_t)n;
+    }
+    return FRAME_OK;
+}
