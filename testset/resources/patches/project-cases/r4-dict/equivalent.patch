  * be inserted using dictInsertKeyAtLink() if the key does not already exist in
  * the dict. If the key exists in the dict, NULL is returned and the optional
  * 'existing' entry pointer is populated, if provided. */
+static dictEntry *dictExistingInBucket(dict *d, dictEntry *he, const void *key,
+                                      keyCmpFunc cmp, dictCmpCache *cache) {
+    while (he) {
+        const void *stored = dictStoredKey2Key(d, dictGetKey(he));
+        if (key == stored || cmp(cache, key, stored)) return he;
+        he = dictGetNext(he);
+    }
+    return NULL;
+}
